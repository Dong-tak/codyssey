# [01] 환경 확인
# 실행 시각: 2026-09-17 22:40:22
# 목적: 로컬에서 실행 가능한 DB와 SQL 실행 도구가 준비돼 있는지 확인한다.

$ which -a sqlite3
/opt/anaconda3/bin/sqlite3
/usr/bin/sqlite3

$ sqlite3 --version
3.45.3 2024-04-15 13:34:05 8653b758870e6ef0c98d46b3ace27849054af85da891eb121e9aaa537f1e8355 (64-bit)

# 주: 셸 PATH에 따라 anaconda(3.45.3) 또는 시스템(3.51.0) 버전이 잡힌다.
#     두 버전 모두 이 과제에서 쓰는 문법을 지원하므로 그대로 진행했다.

$ python3 -c "import sqlite3; print(sqlite3.sqlite_version)"
3.45.3

$ ls /Applications | grep -i dbeaver   # GUI 도구
DBeaver.app

# 결론: DB(SQLite) + CLI(sqlite3) + GUI(DBeaver) 모두 준비됨.
