# ===== macOS 시스템 파일 =====
.DS_Store

# ===== 환경변수 / 비밀정보 =====
.env
.env.local
*.key

# ===== 로그 파일 =====
*.log
# 단, 과제 증거인 실습 로그는 예외로 추적한다
!logs/*.log

# ===== 의존성 폴더 (Node.js 예시) =====
node_modules/

# ===== 임시 파일 =====
*.tmp
.cache/

# ===== 개발 보조 도구 상태 파일 (과제 산출물과 무관) =====
.bkit/
.omc/

# ===== 터미널 실습용 임시 디렉토리 =====
# 실습 로그는 logs/ 에 남기고, 실습 중 만든 파일 자체는 추적하지 않는다
practice/