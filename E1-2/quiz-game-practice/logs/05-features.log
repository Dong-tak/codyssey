>>> from quiz_game import QuizGame
>>> game = QuizGame()
>>> game.has_played = False
>>> game.check_score()
아직 퀴즈를 풀지 않았습니다.
>>> game.has_played = True
>>> game.best_score = 3
>>> game.check_score()
